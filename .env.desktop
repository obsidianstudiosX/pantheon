# Pantheon Desktop — copy this file to .env when developing the desktop app.
# Replaces the LobeHub-branded .env.desktop defaults.
APP_URL=http://localhost:3015
FEATURE_FLAGS=-check_updates,+pin_list
KEY_VAULTS_SECRET=oLXWIiR/AKF+rWaqy9lHkrYgzpATbW3CtJp3UfkVgpE=
DATABASE_URL=postgresql://postgres@localhost:5432/postgres
SEARCH_PROVIDERS=search1api
DESKTOP_BUILD=true

# --- Pantheon-specific sign-in flow ---------------------------------------
# Pre-filled URL for the onboarding "Connect to your own server" field. The
# LobeHub Cloud sign-in button has been removed from the Pantheon build.
DEFAULT_PANTHEON_SERVER_URL=http://127.0.0.1:3210
# Belt-and-suspenders switch — set to 1 to disable any remaining OIDC /
# LobeHub Cloud auth paths at runtime.
DISABLE_LOBEHUB_CLOUD_AUTH=1
